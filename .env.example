# ============================================================================
# ENVIRONMENT VARIABLES - PRODUCTION (Vercel/Deployment)
# ============================================================================
# Copy this file to .env and fill in the values for your deployment

# Node Environment
NODE_ENV=production

# Server Configuration
PORT=3000
LOG_LEVEL=info

# ============================================================================
# DATABASE - Neon PostgreSQL
# ============================================================================
# Get this from your Neon project dashboard
# Format: postgresql://user:password@host/database?channel_binding=require&sslmode=require
DATABASE_URL=postgresql://username:password@host/database?channel_binding=require&sslmode=require

# ============================================================================
# JWT Authentication
# ============================================================================
# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Access token expiration (15 minutes recommended)
JWT_EXPIRATION=15m

# Refresh token expiration (7 days recommended)
JWT_REFRESH_EXPIRATION=7d

# ============================================================================
# NOTES
# ============================================================================
# In Vercel, set these environment variables in:
# 1. Go to your Vercel project dashboard
# 2. Settings → Environment Variables
# 3. Add each variable listed above
# 4. For production deployment, use the "Production" environment
#
# Never commit the actual .env file with real credentials to git.
# The .env file is listed in .gitignore for security.
